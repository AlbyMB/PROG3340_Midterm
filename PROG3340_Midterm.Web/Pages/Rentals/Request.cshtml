@page
@model PROG3340_Midterm.Web.Pages.Rentals.RequestModel
@{
    ViewData["Title"] = "Request Rental";
    var userId = ViewContext.HttpContext.Session.GetString("UserId") ?? "";
}
<h2>Request Rental</h2>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label">Equipment</label>
        <select asp-for="Issue.EquipmentId" asp-items="Model.EquipmentOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Due date</label>
        <input asp-for="Issue.DueDate" type="date" class="form-control" />
    </div>
    <button class="btn btn-success" type="submit">Submit Request</button>
    <a asp-page="/Equipment/Index" class="btn btn-secondary">Cancel</a>
    @if (!string.IsNullOrEmpty(Model.Success))
    {
        <span class="ms-2 text-success">@Model.Success</span>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <span class="ms-2 text-danger">@Model.Error</span>
    }
    <div asp-validation-summary="All" class="text-danger mt-2"></div>
    <!-- Explicitly include critical fields so backend gets them -->
    <input type="hidden" name="Issue.CustomerId" value="@userId" />
    <input type="hidden" name="Issue.IssuedAt" value="@DateTime.Now.ToString("o")" />
    <input asp-for="Issue.Status" type="hidden" />
    <input asp-for="Issue.Notes" type="hidden" />
</form>
