@page
@model PROG3340_Midterm.Web.Pages.Customers.ManageModel
<h2>Customers</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Create</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.UserName</td>
            <td>@c.Email</td>
            <td>@c.Role</td>
            <td>
                <a asp-page="Edit" asp-route-id="@c.Id">Edit</a> |
                <a asp-page="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
