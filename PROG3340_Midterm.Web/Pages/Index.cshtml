@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    @if (HttpContext.Session.GetString("JWT") is null)
    {
        <p><a asp-page="/Account/Login" class="btn btn-primary">Login</a></p>
    }
    else if (HttpContext.Session.GetString("Role") == "Admin")
    {
        <p><a asp-page="/Dashboard/AdminDashboard" class="btn btn-success">Go to Admin Dashboard</a></p>
    }
    else
    {
        <p><a asp-page="/Dashboard/UserDashboard" class="btn btn-success">Go to User Dashboard</a></p>
    }
</div>
